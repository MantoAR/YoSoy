# Puerto del servidor de señalización
PORT=3001

# Secreto JWT HS256: DEBE ser idéntico a Jwt:Secret del backend .NET (env Jwt__Secret).
# Mínimo 32 bytes. NO commitear el valor real.
JWT_SECRET=CAMBIAR-secreto-compartido-con-el-signaling-minimo-32-bytes

# Orígenes permitidos para CORS (lista separada por comas). NUNCA usar *.
CORS_ORIGINS=http://localhost:5000,http://localhost:5500

# URL del backend .NET para consultar el estado de la sesión.
BACKEND_URL=http://localhost:5000

# Secreto interno server-to-server para GET /sesiones/{id}/estado.
# Debe coincidir con Signaling:SecretoInterno del backend (env Signaling__SecretoInterno).
INTERNAL_SECRET=

# Modo LAN/demo: si es true y el backend no responde, se permite la unión (solo para pruebas locales).
MODO_LAN=true
