{
  "name": "yosoy-whatsapp-service",
  "version": "1.0.0",
  "private": true,
  "description": "Puente HTTP interno entre la API de YoSoy y WhatsApp, con Baileys (WhatsApp Web sin navegador). No se expone a internet (ver README.md).",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "vincular": "node vincular.js",
    "test": "node --require ./test/helpers/sin-red.js --test --test-timeout=60000 \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "express": "^4.19.2",
    "qrcode": "1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "overrides": {
    "libsignal": "6.0.0"
  }
}
