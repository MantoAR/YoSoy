# ───────────────────────────────────────────────────────────────────────────
# Variables de entorno del BACKEND .NET (YoSoy)
#
# Solo PLACEHOLDERS. NO commitear valores reales.
# ASP.NET Core mapea env vars a la configuración con doble guión bajo "__"
# (p.ej. Jwt__Secret  ->  sección Jwt, clave Secret). En appsettings.json los
# valores quedan vacíos / de demo; en producción se sobrescriben con estas vars.
#
# En Windows PowerShell:   $env:Jwt__Secret = "..."
# En Linux/systemd:        Environment="Jwt__Secret=..."  (o un archivo EnvironmentFile)
# ───────────────────────────────────────────────────────────────────────────

# Cadena de conexión a SQL Server (Express en local).
ConnectionStrings__YoSoy=Server=.\SQLEXPRESS;Database=yosoy;Trusted_Connection=True;TrustServerCertificate=True;

# Secreto JWT HS256 (login-JWT y JWT de sesión). MISMO valor que JWT_SECRET del signaling.
# Mínimo 32 bytes.
Jwt__Secret=CAMBIAR-secreto-compartido-con-el-signaling-minimo-32-bytes
Jwt__Issuer=yosoy

# Secreto coturn (use-auth-secret). MISMO valor que static-auth-secret de turnserver.conf.
Turn__Habilitado=true
Turn__StaticAuthSecret=CAMBIAR-secreto-coturn-use-auth-secret
Turn__TtlSegundos=600
Turn__Urls__0=turn:turn.comuna31.com.ar:3478?transport=udp
Turn__Urls__1=turns:turn.comuna31.com.ar:5349?transport=tcp

# Clave de cifrado AES-GCM en reposo para datos de emociones. base64 de 32 bytes.
# Generar:  [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))  (PowerShell)
#           openssl rand -base64 32                                       (Linux)
Sesion__ClaveCifrado=CAMBIAR-base64-de-32-bytes
Sesion__ModoLan=false
Sesion__MargenIngresoMinutos=5
Sesion__DuracionTurnoDefaultMinutos=60

# Secreto interno server-to-server: el signaling lo manda en X-Internal-Secret
# para consultar GET /sesiones/{id}/estado. MISMO valor que INTERNAL_SECRET del signaling.
Signaling__SecretoInterno=CAMBIAR-secreto-interno-backend-signaling
Signaling__UrlPublica=https://comuna31.com.ar

# Orígenes CORS permitidos (índices). NUNCA usar *.
Cors__Origenes__0=https://comuna31.com.ar

# Dominio público (se usa para armar los links de invitación por email).
Dominio=https://comuna31.com.ar

# Rate limiting (ventana en segundos; intentos por IP).
RateLimit__VentanaSegundos=300
RateLimit__Login=3
RateLimit__Sesion=5

# SMTP para emails (aprobaciones, invitaciones, reset). Diferido / opcional en demo.
Email__Host=smtp.gmail.com
Email__Port=587
Email__From=CAMBIAR@gmail.com
Email__Password=CAMBIAR-app-password
Email__AppUrl=https://comuna31.com.ar
