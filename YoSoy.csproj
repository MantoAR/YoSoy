<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>efdf1a94-9804-4dac-bd57-697e1ef341f9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
  </ItemGroup>

  <!-- El proyecto de tests vive adentro de esta carpeta: que no se compile como parte de la app. -->
  <ItemGroup>
    <Compile Remove="YoSoy.Tests/**" />
    <Content Remove="YoSoy.Tests/**" />
    <None Remove="YoSoy.Tests/**" />
  </ItemGroup>

  <!-- Ni docs/ (sql de prueba, capturas, tokens de prueba gitignoreados) ni signaling-server/
       (otro proceso, Node) son parte de la API: que dotnet publish no los arrastre. -->
  <ItemGroup>
    <Compile Remove="docs/**;signaling-server/**" />
    <Content Remove="docs/**;signaling-server/**" />
    <None Remove="docs/**;signaling-server/**" />
  </ItemGroup>

  <!-- PANTALLAS/ es el frontend que sirve la propia API (UseStaticFiles en Program.cs).
       El SDK clasifica la mayoría de los archivos ahí (.html/.js/.css) como None por
       default, y None no se copia al publicar; unos pocos .json ya entraban solos como
       Content. El Remove limpia ambos casos antes de incluir todo de nuevo, explícito,
       para no terminar con el mismo archivo contado dos veces. -->
  <ItemGroup>
    <Content Remove="PANTALLAS/**" />
    <None Remove="PANTALLAS/**" />
    <Content Include="PANTALLAS/**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
